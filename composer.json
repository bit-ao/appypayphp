{
    "name": "bit/appypayphp",
    "description": "AppyPay PHP SDK - Pagamentos online em Angola",
    "type": "library",
    "keywords": ["appypay", "angola", "online-payment", "bit"],
    "license": "MIT",
    "authors": [
        {
            "name": "Bantu Internet Technologies",
            "email": "opensource@bit.ao"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Bit\\AppyPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bit\\AppyPay\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
